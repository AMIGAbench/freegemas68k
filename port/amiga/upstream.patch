+#ifdef AMIGA
+    /**
+     * Amiga: a vector instead of a multimap -- no heap node per draw call.
+     * Window::gameLoop() calls sortByDepth() (stable, so equal depths keep the
+     * order of the draw calls, as in the multimap) before it iterates.
+     */
+    typedef std::pair<float, DrawingQueueOperation> DrawingQueueEntry;
+
+    class DrawingQueue : private std::vector<DrawingQueueEntry>
+    {
+    public:
+        DrawingQueue() { reserve(512); }
+
+        void draw(float z, DrawingQueueOperation operation)
+        {
+            push_back(DrawingQueueEntry(z, operation));
+        }
+
+    private:
+        // insertion sort: stable, no allocation, fast on the nearly sorted queue
+        void sortByDepth()
+        {
+            DrawingQueueEntry * a = data();
+            for (size_t i = 1, n = size(); i < n; ++i) {
+                if (!(a[i].first < a[i - 1].first)) continue;
+                DrawingQueueEntry e = a[i];
+                size_t j = i;
+                while (j > 0 && e.first < a[j - 1].first) { a[j] = a[j - 1]; --j; }
+                a[j] = e;
+            }
+        }
+        friend class Window;
+    };
+
+    typedef std::vector<DrawingQueueEntry>::const_iterator DrawingQueueIterator;
+#else
     /**
      * Represents a drawing queue, where the Drawable objects will be drawn
      * depending on their depth (which is the key of the map).
@@ -59,6 +97,8 @@ namespace GoSDL {
